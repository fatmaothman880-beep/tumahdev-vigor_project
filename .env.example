# Browser and Node gateway
VITE_API_URL=/api/v1
VITE_USE_MOCK_API=false
HOST=127.0.0.1
PORT=3000
OPERATIONS_API_URL=http://127.0.0.1:8000/api/v1
AUTH_DATA_PATH=./data/auth.json
AUTH_SECRET=

# Native PostgreSQL and FastAPI
# Replace the password; URL-encode special characters in it.
DATABASE_URL=postgresql+psycopg://vigor_user:REPLACE_ME@127.0.0.1:5432/vigor_port
BACKEND_PORT=8000
API_PREFIX=/api/v1
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional server-side AI enhancement
GEMINI_API_KEY=

# Optional neural intent retrieval; exact answers still come from database records.
AI_EMBEDDING_MODEL=gemini-embedding-001
