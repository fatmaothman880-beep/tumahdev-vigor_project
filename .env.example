# Demo defaults only. Copy this file to .env and keep .env untracked.
COMPOSE_PROJECT_NAME=smart-port-mvp1

POSTGRES_DB=smart_port
POSTGRES_USER=smart_port
POSTGRES_PASSWORD=change-me-for-non-local-use
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smart_port:change-me-for-non-local-use@db:5432/smart_port

BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Provisional demo assumption; requires site validation.
POST_UNLOAD_MINUTES=60

