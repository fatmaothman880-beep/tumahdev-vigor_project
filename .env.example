# Demo defaults only. Copy this file to .env and keep .env untracked.

COMPOSE_PROJECT_NAME=smart-port-mvp1

# PostgreSQL
POSTGRES_DB=smart_port
POSTGRES_USER=smart_port
POSTGRES_PASSWORD=change-me-for-non-local-use
POSTGRES_PORT=5432

# Docker Compose database connection
DATABASE_URL=postgresql+psycopg://smart_port:change-me-for-non-local-use@db:5432/smart_port

# For development outside Docker, replace DATABASE_URL with:
# DATABASE_URL=postgresql+psycopg://smart_port:change-me-for-non-local-use@localhost:5432/smart_port

# Backend
APP_NAME=Port Monitoring System
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Provisional demo assumption; requires site validation.
POST_UNLOAD_MINUTES=60