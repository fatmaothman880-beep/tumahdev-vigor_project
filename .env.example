# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# VIGOR Smart Port Operations FastAPI + PostgreSQL Backend Configuration
VITE_API_URL=/api/v1
VITE_USE_MOCK_API=false

# Integrated Docker stack
COMPOSE_PROJECT_NAME=vigor-smart-port
POSTGRES_DB=smart_port
POSTGRES_USER=smart_port
POSTGRES_PASSWORD=change-me-for-non-local-use
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smart_port:change-me-for-non-local-use@localhost:5432/smart_port
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_PREFIX=/api/v1
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Node gateway; browsers must use this gateway for authentication.
OPERATIONS_API_URL=http://127.0.0.1:8000/api/v1
AUTH_SECRET=
AUTH_DATA_PATH=./data/auth.json
